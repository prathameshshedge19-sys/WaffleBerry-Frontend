{
  "name": "legarya-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "LegaRya web client and bundled Capacitor Android application",
  "license": "UNLICENSED",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:android": "node --test tests/android-mobile-build.test.mjs",
    "mobile:build": "node tools/build-android-web.mjs",
    "android:sync": "npm run mobile:build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
