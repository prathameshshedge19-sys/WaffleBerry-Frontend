    "@capacitor/keyboard": "8.0.5",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
