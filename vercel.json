{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node tools/build-static-web.mjs",
  "outputDirectory": "dist/web",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://89-167-14-211.sslip.io/api/v1/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "waffle-berry-frontend.vercel.app"
        }
      ],
      "destination": "https://www.waffleberry.app/$1",
      "permanent": true
    },
    {
      "source": "/experience.html",
      "destination": "https://www.waffleberry.app/",
      "permanent": true
    },
    {
      "source": "/realtime-dev.html",
      "destination": "/gateway.html",
      "permanent": false
    }
  ]
}
