{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "waffle-berry-frontend.vercel.app"
        }
      ],
      "destination": "https://www.waffleberry.app/:path*",
      "permanent": true
    }
  ]
}